{
  "name": "branch-validation",
  "version": "1.0.0",
  "description": "Claude Code skill for choosing and validating branch names against LightSpeed WP's org-wide branching strategy",
  "main": "SKILL.md",
  "scripts": {
    "test": "node --test scripts/__tests__/*.test.cjs",
    "test:bats": "bats tests/*.bats",
    "test:all": "npm test && npm run test:bats",
    "validate:branch-name": "node scripts/validate-branch-name.cjs",
    "sync": "bash scripts/sync-canonical.sh"
  },
  "keywords": [
    "branch-validation",
    "branching-strategy",
    "git",
    "cli",
    "skill",
    "claude"
  ],
