  "devDependencies": {
    "lefthook": "^2.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lightspeedwp/ls-wp-branches.git"
  },
  "bugs": {
